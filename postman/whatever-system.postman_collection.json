    {
      "name": "Dex Actions",
      "item": [
        {
          "name": "Get All Dex Actions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dex-actions?page=1&limit=20&orderBy=time&direction=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.items).to.exist;",
                  "if (json.items && json.items.uniswapV2 && json.items.uniswapV2.length > 0) {",
                  "  pm.collectionVariables.set('dexActionV2Id', json.items.uniswapV2[0].id);",
                  "  pm.collectionVariables.set('dexActionTxHash', json.items.uniswapV2[0].txHash);",
                  "  pm.collectionVariables.set('dexActionAddress', json.items.uniswapV2[0].dexAddress || json.items.uniswapV2[0].poolAddress);",
                  "  pm.collectionVariables.set('dexActionChainId', String(json.items.uniswapV2[0].chainId));",
                  "}",
                  "if (json.items && json.items.uniswapV3 && json.items.uniswapV3.length > 0) {",
                  "  pm.collectionVariables.set('dexActionV3Id', json.items.uniswapV3[0].id);",
                  "  pm.collectionVariables.set('dexActionTxHash', json.items.uniswapV3[0].txHash);",
                  "  pm.collectionVariables.set('dexActionAddress', json.items.uniswapV3[0].dexAddress || json.items.uniswapV3[0].poolAddress);",
                  "  pm.collectionVariables.set('dexActionChainId', String(json.items.uniswapV3[0].chainId));",
                  "}"
