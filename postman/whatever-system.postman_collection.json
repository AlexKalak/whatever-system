{
  "info": {
    "name": "Whatever System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD tests for assets and asset-mappings endpoints"
  },
  "item": [
    {
      "name": "Assets",
      "item": [
        {
          "name": "Create Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bitcoin\",\n  \"symbol\": \"BTC\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('assetId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Asset By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(pm.collectionVariables.get('assetId'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Asset",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bitcoin Updated\",\n  \"symbol\": \"BTC\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.name).to.eql('Bitcoin Updated');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Asset",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Asset Mappings",
      "item": [
        {
          "name": "Create Asset Mapping",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"onchain\",\n  \"name\": \"BTC Mainnet\",\n  \"exchange\": \"\",\n  \"symbolOnExchange\": \"\",\n  \"chainID\": 1,\n  \"address\": \"0x1234567890abcdef1234567890abcdef12345678\",\n  \"decimals\": 8\n}"
            },
            "url": "{{baseUrl}}/asset-mappings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('mappingId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Asset Mappings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/asset-mappings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Asset Mapping By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/asset-mappings/{{mappingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(pm.collectionVariables.get('mappingId'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Asset Mapping",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"onchain\",\n  \"name\": \"BTC Mainnet Updated\",\n  \"exchange\": \"\",\n  \"symbolOnExchange\": \"\",\n  \"chainID\": 1,\n  \"address\": \"0xabcdefabcdefabcdefabcdefabcdefabcdefabcd\",\n  \"decimals\": 8\n}"
            },
            "url": "{{baseUrl}}/asset-mappings/{{mappingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.name).to.eql('BTC Mainnet Updated');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Asset Mapping",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/asset-mappings/{{mappingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "assetId", "value": "" },
    { "key": "mappingId", "value": "" }
  ]
}
