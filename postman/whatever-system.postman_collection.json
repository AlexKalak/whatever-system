                  "const json = pm.response.json();",
                  "pm.expect(json.name).to.eql('BTC Mainnet Updated');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Asset Mapping",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/asset-mappings/{{mappingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
