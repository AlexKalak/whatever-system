{
  "info": {
    "name": "Whatever System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD tests for assets, asset-mappings and dex endpoints"
  },
  "item": [
    {
      "name": "Setup Assets For Dex",
      "item": [
        {
          "name": "Create Asset 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wrapped Ether\",\n  \"symbol\": \"WETH\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('asset1Id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Asset 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USD Coin\",\n  \"symbol\": \"USDC\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('asset2Id', json.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "Create Asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bitcoin\",\n  \"symbol\": \"BTC\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('assetId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Asset By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(pm.collectionVariables.get('assetId'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bitcoin Updated\",\n  \"symbol\": \"BTC\",\n  \"type\": \"crypto\"\n}"
            },
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.name).to.eql('Bitcoin Updated');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Asset",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
